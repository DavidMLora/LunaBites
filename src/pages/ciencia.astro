---
import PublicLayout from '../layouts/PublicLayout.astro';
import BotanicalSection from '../components/science/BotanicalSection.astro';
import HydrolateExplainer from '../components/science/HydrolateExplainer.astro';
import ProductionProcess from '../components/science/ProductionProcess.astro';
import { plants } from '../data/plants';
---

<PublicLayout
  title="Nuestra ciencia"
  description="Conoce nuestras plantas: valeriana, toronjil morado y pasiflora. Descubre los hidrolatos que dan vida a la repostería botánica de Luna Bites."
>
  <section class="science-intro night">
    <div class="wrap">
      <div>
        <p class="eyebrow">Conoce nuestras plantas</p><h1>
          La botánica inspira.<br /><em>La curiosidad<br />nos guía.</em>
        </h1><p class="intro-description">
          Galletas inspiradas en la naturaleza, elaboradas con una combinación de hidrolatos de
          valeriana, toronjil morado y pasiflora. Tres plantas con características únicas que dan
          vida a nuestra propuesta de repostería.
        </p>
      </div><figure class="herb-cover">
        <img
          src="/images/pasiflora.png"
          width="512"
          height="424"
          alt="Ilustración de pasiflora"
        /><span>Un pequeño universo<br />en cada ingrediente.</span>
      </figure>
    </div>
  </section>
  <div class="wrap science-disclaimer">Luna Bites es un alimento, no un medicamento.</div>
  <div class="wrap">
    {
      plants.map((plant, index) => (
        <BotanicalSection
          id={plant.id}
          number={plant.number}
          name={plant.name}
          scientific={plant.scientific}
          reverse={index === 1}
        >
          {plant.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </BotanicalSection>
      ))
    }
  </div>
  <HydrolateExplainer /><ProductionProcess />
  <div class="wrap science-sources" style="padding-bottom:55px">
    <details>
      <summary>Referencias botánicas</summary>
      <p>
        Valeriana: <a
          href="https://doi.org/10.1016/j.amjmed.2006.02.026"
          target="_blank"
          rel="noopener noreferrer">revisión sobre valeriana y sueño (2006)</a
        >
        · <a
          href="https://www.nccih.nih.gov/health/valerian"
          target="_blank"
          rel="noopener noreferrer">NCCIH · Valeriana</a
        >.
      </p>
      <p>
        Toronjil morado: <a
          href="https://www.mdpi.com/1420-3049/26/12/3751"
          target="_blank"
          rel="noopener noreferrer"
          >Agastache mexicana: biología, fitoquímica y bioactividad (2021)</a
        >.
      </p>
      <p>
        Pasiflora: <a
          href="https://www.frontiersin.org/journals/pharmacology/articles/10.3389/fphar.2020.00617/full"
          target="_blank"
          rel="noopener noreferrer">Passiflora edulis: fitoquímica y farmacología (2020)</a
        >.
      </p>
      <p>
        Hidrolatos: <a
          href="https://journals.usamvcluj.ro/index.php/horticulture/article/view/15253"
          target="_blank"
          rel="noopener noreferrer">producción y composición de hidrolatos</a
        >.
      </p>
    </details>
  </div>
</PublicLayout>
