---
interface Props {
  id: string;
  number: string;
  name: string;
  scientific: string;
  reverse?: boolean;
}
const { id, number, name, scientific, reverse = false } = Astro.props;
---

<section id={id} class:list={['botanical-section', { reverse }]}>
  <figure class="botanical-art">
    <img
      src={'/images/' + id + '.png'}
      width="365"
      height="365"
      alt={'Ilustración botánica de ' + name}
      loading="lazy"
    /><span>FIG. {number} · HERBARIO LUNA BITES</span>
  </figure><div class="botanical-text">
    <p class="eyebrow">{number} / Ingredientes con historia</p><h2>{name}</h2><p class="latin-name">
      {scientific}
    </p><slot />
  </div>
</section>
