---
import Icon from '../layout/Icon.astro';
import { plants } from '../../data/plants';
---

<section class="science-preview section-space wrap">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Nuestro pequeño herbario</p><h2>
        La naturaleza tiene<br /><em>mucho que contarnos.</em>
      </h2>
    </div><a class="text-link" href="/ciencia"
      >Explora nuestra ciencia <Icon name="arrow" size={19} /></a
    >
  </div><div class="herb-gallery">
    {
      plants.map((plant) => (
        <a href={'/ciencia#' + plant.id} class={'herb-preview herb-' + plant.id}>
          <>
            <span class="herb-number">{plant.number} / HERBARIO</span>
            <img
              src={'/images/' + plant.id + '.png'}
              width="312"
              height="306"
              alt={'Ilustración de ' + plant.name}
              loading="lazy"
            />
            <div>
              <>
                <h3>{plant.name}</h3>
                <p>{plant.scientific}</p>
                <span aria-hidden="true">↗</span>
              </>
            </div>
          </>
        </a>
      ))
    }
  </div><p class="science-caption">
    Valeriana, toronjil morado y pasiflora: tres plantas que dan vida a nuestra repostería botánica.
  </p>
</section>
